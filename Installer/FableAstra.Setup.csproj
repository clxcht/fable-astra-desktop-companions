<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Fable-Astra-Setup</AssemblyName>
    <Version>1.2.1</Version>
    <Description>Install Fable chan and Astra chan desktop companions</Description>
    <ApplicationIcon>../Source/companion.ico</ApplicationIcon>
    <ApplicationManifest>../Source/app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PayloadPath Condition="'$(PayloadPath)' == ''">payload.zip</PayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="Payload.zip" />
    <EmbeddedResource Include="Uninstall.ps1" LogicalName="Uninstall.ps1" />
  </ItemGroup>
</Project>
