<Window x:Class="FableAstra.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Fable chan + Astra chan" Width="432" Height="414"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Viewbox Stretch="Uniform">
  <Grid x:Name="Scene" Width="432" Height="414">
   <Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="272"/></Grid.RowDefinitions>
   <Grid x:Name="SpeechArea" Margin="10,4,10,4" VerticalAlignment="Bottom" Visibility="Collapsed">
    <Border x:Name="Bubble" Padding="17,13,17,15" Background="#FFF9F1" BorderBrush="#D7C7BA" BorderThickness="1" CornerRadius="15" Margin="0,0,0,10" MouseLeftButtonDown="DragCompanions">
     <StackPanel>
      <DockPanel Margin="0,0,0,7">
       <TextBlock x:Name="SpeakerName" Foreground="#964123" FontSize="11" FontWeight="Bold"/>
       <TextBlock x:Name="TopicLabel" HorizontalAlignment="Right" Foreground="#736972" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
      </DockPanel>
      <TextBlock x:Name="SpeechText" FontFamily="Segoe UI" FontSize="15" LineHeight="21" LineStackingStrategy="BlockLineHeight" MaxHeight="84" TextWrapping="Wrap" TextTrimming="WordEllipsis" Foreground="#302A31" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel>
    </Border>
    <Path x:Name="BubbleTail" Data="M 0,0 L 13,12 L 25,0 Z" Fill="#FFF9F1" Stroke="#D7C7BA" StrokeThickness="1" Width="26" Height="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="83,0,0,0"/>
   </Grid>
   <Grid Grid.Row="1" Margin="14,0" ClipToBounds="True">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Image x:Name="FableImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Margin="5,4,5,0" VerticalAlignment="Bottom" MaxHeight="267" RenderTransformOrigin="0.5,1" Cursor="SizeAll" ToolTip="Drag to move · Controls are in the tray icon" MouseLeftButtonDown="DragCompanions" AutomationProperties.Name="Fable chan">
     <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
    </Image>
    <Image x:Name="AstraImage" Grid.Column="1" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" Margin="0,4,0,0" VerticalAlignment="Bottom" MaxHeight="267" RenderTransformOrigin="0.5,1" Cursor="SizeAll" ToolTip="Drag to move · Controls are in the tray icon" MouseLeftButtonDown="DragCompanions" AutomationProperties.Name="Astra chan">
     <Image.RenderTransform><ScaleTransform/></Image.RenderTransform>
    </Image>
   </Grid>
  </Grid>
 </Viewbox>
</Window>
